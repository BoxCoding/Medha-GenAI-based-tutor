# ============================================================
# Medhā — production env for the deployed Vercel project
#   https://medha-gen-ai-based-tutor-kked.vercel.app
# Paste into: Vercel → Project → Settings → Environment Variables
# (one variable per line; set for Production. Never commit the real key.)
# ============================================================

# --- Required ---

# Your Gemini key — paste the real value in the Vercel dashboard and mark
# it "Sensitive". Placeholder kept here so no secret lives in the repo.
GEMINI_API_KEY=your-gemini-api-key-here

# Vercel serves over HTTPS — session cookie must be Secure.
COOKIE_SECURE=1

# --- Recommended ---

GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT=40

# Only /tmp is writable on Vercel serverless (ephemeral — resets on cold
# starts; see deploy/DEPLOYMENT.md for persistent-hosting options).
MEDHA_DB=/tmp/medha.db

# --- Not needed for this deployment (same-origin single project) ---
# The frontend and /api/* share https://medha-gen-ai-based-tutor-kked.vercel.app,
# so CORS and cross-site cookies never come into play. These would only
# matter if the frontend were ever hosted on a DIFFERENT origin:
#
# ALLOWED_ORIGINS=https://medha-gen-ai-based-tutor-kked.vercel.app
# COOKIE_SAMESITE=none
# MEDHA_API_BASE=https://medha-gen-ai-based-tutor-kked.vercel.app  (frontend project)
#
# (Note: no trailing slash on any origin value.)

# --- Optional ---

# Judge-proof fallback: forces deterministic offline content, zero LLM calls.
# MEDHA_OFFLINE=1
