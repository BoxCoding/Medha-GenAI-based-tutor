# ============================================================
# Medhā — Vercel environment variables (single project:
# backend serverless function + static frontend, same origin)
# Vercel Dashboard → Project → Settings → Environment Variables
# Add each line as a separate variable. Never commit real values.
# ============================================================

# --- Required ---

# Gemini API key. Mark as "Sensitive" in Vercel. Lives only in the
# serverless function — the static frontend never sees it.
GEMINI_API_KEY=your-gemini-api-key-here

# Session cookie over HTTPS only (Vercel is always HTTPS).
COOKIE_SECURE=1

# --- Recommended ---

# Gemini model id.
GEMINI_MODEL=gemini-3.1-flash-lite

# LLM request timeout in seconds.
LLM_TIMEOUT=40

# SQLite path. On Vercel serverless only /tmp is writable — and it is
# EPHEMERAL: accounts and progress reset between cold starts. Fine for a
# quick demo; for persistent data run the same app on an always-on host
# (Railway / Render / Fly.io / a VPS with `uvicorn backend.main:app`) —
# no code changes needed.
MEDHA_DB=/tmp/medha.db

# --- Optional ---

# Set to 1 to force deterministic offline content (no Gemini calls) —
# a judge-proof fallback deployment.
# MEDHA_OFFLINE=1

# NOT needed in single-project mode (same origin, so no CORS and the
# default SameSite=Lax cookie is correct). Only for a split deployment:
# ALLOWED_ORIGINS=
# COOKIE_SAMESITE=lax

# Ignored on Vercel (platform routes requests); only for self-hosting:
# HOST=0.0.0.0
# PORT=8098
